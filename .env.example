# 이 파일을 `.env`로 복사하고 키를 채우면 AI 기능(자연어 명령/챗봇/분석)이 훨씬 빨라집니다.
# 키가 하나도 없으면 Claude Code CLI로 폴백합니다 (동작은 하지만 호출당 15~25초).
# 우선순위: GEMINI > GROQ > OPENAI > claude CLI
APP_ENV=local
LLM_PROVIDER=legacy

# 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# 무료 발급: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 유료: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Public deployment: configure these in hosting settings, NOT this local file.
# Production and gemini-free mode never load .env.
# APP_ENV=production
# LLM_PROVIDER=gemini-free
# GEMINI_FREE_TIER_ONLY=true
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=<free-tier project key; never enable billing on that project>
# AI_QUOTA_FILE=/home/layout-data/ai-quota.json
# SAVED_LAYOUT_PATH=/home/layout-data/saved_layout.json
